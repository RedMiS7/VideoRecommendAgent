# Copy this template to .env and configure credentials locally.
DATA_DIR=data
TEXT_PROVIDER=qwen
TEXT_MODEL=qwen3.8-flash
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EVAL_PROVIDER=qwen
EVAL_MODEL=qwen3.8-flash
MODEL_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# Optional per-capability overrides; blank values use the shared model settings above.
TEXT_BASE_URL=
TEXT_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EVAL_BASE_URL=
EVAL_API_KEY=
# EnhancedSearch MCP; blank SEARCH_API_KEY uses DASHSCOPE_API_KEY independently of model overrides.
SEARCH_API_KEY=
SEARCH_MCP_URL=https://maas.qianwenaiapi.com/api/v1/mcps/EnhancedSearch/mcp
# Bilibili login cookies. SESSDATA is required by the subtitle SDK; keep values local.
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=
